generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  FREELANCER
  INDIVIDUAL
  TEAM
}

enum SearchPackStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  FAILED
  CANCELLED
}

enum PlatformType {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  LINKEDIN
}

enum CampaignCreatorStatus {
  NOT_CONTACTED
  CONTACTED
  RESPONDED
  ACCEPTED
  DECLINED
  AWAITING_CONTENT
  CONTENT_DELIVERED
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  password         String
  fullName         String
  refreshTokenHash String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  subscriptions    Subscription[]
  paymentMethods   PaymentMethod[]
  campaigns        Campaign[]
  savedCreators    SavedCreator[]
  ownedTeamMembers TeamMembership[] @relation("TeamOwner")
  teamMembership   TeamMembership? @relation("TeamMember")
  searchPackPurchases SearchPackPurchase[]
  freeSearchesUsed    Int                  @default(0)
}

model PaymentMethod {
  id          String         @id @default(cuid())
  userId      String
  provider    String         @default("flutterwave")
  token       String
  last4       String?
  cardType    String?
  expiryMonth String?
  expiryYear  String?
  isDefault   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId])
}

model Subscription {
  id                        String             @id @default(cuid())
  userId                    String
  paymentMethodId           String?
  plan                      SubscriptionPlan
  status                    SubscriptionStatus @default(PENDING)
  autoRenew                 Boolean            @default(false)
  flutterwaveTransactionId  String?            @unique
  flutterwaveReference      String?            @unique
  flutterwaveSubscriptionId Int?               @unique
  flutterwavePaymentPlanId  Int?
  searchesUsed              Int                @default(0)
  searchCredits             Int                @default(0)
  expiresAt                 DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod             PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  searchPackPurchases       SearchPackPurchase[]

  @@index([userId, status])
  @@index([flutterwavePaymentPlanId])
  @@index([paymentMethodId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  ownerId   String
  memberId  String   @unique
  createdAt DateTime @default(now())
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member    User     @relation("TeamMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model SearchPackPurchase {
  id             String           @id @default(cuid())
  userId         String
  subscriptionId String
  reference      String           @unique
  transactionId  String?          @unique
  status         SearchPackStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([subscriptionId])
}

model Creator {
  id                  String                     @id @default(cuid())
  name                String
  gender              String?
  country             String?
  state               String?
  primaryCategoryId   String?
  businessEmail       String?
  profileImage        String?
  pfpError            String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  primaryCategory     Category?                  @relation("CreatorPrimaryCategory", fields: [primaryCategoryId], references: [id])
  secondaryCategories CreatorSecondaryCategory[]
  platforms           CreatorPlatform[]
  searchTags          SearchTag[]
  campaignCreators    CampaignCreator[]
  savedCreators       SavedCreator[]

  @@index([primaryCategoryId])
  @@index([state])
}

model CreatorPlatform {
  id          String       @id @default(cuid())
  creatorId   String
  platform    PlatformType
  handle      String
  followers   Int
  verified    Boolean      @default(false)
  profileUrl  String?
  lastUpdated DateTime     @default(now())
  creator     Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, platform])
}

model SearchTag {
  id        String   @id @default(cuid())
  creatorId String
  tag       String
  createdAt DateTime @default(now())
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([tag])
}

model Category {
  id               String                     @id @default(cuid())
  name             String
  slug             String                     @unique
  description      String?
  parentId         String?
  level            Int
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  parent           Category?                  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]                 @relation("CategoryTree")
  creatorPrimary   Creator[]                  @relation("CreatorPrimaryCategory")
  creatorSecondary CreatorSecondaryCategory[]
  campaignIntents  CampaignIntentCategory[]

  @@index([parentId])
  @@index([level])
}

model CreatorSecondaryCategory {
  creatorId   String
  categoryId  String
  createdAt   DateTime @default(now())
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([creatorId, categoryId])
  @@index([categoryId])
}

model CampaignIntent {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  categories  CampaignIntentCategory[]
  tags        CampaignIntentTag[]
}

model CampaignIntentCategory {
  campaignIntentId String
  categoryId       String
  campaignIntent   CampaignIntent @relation(fields: [campaignIntentId], references: [id], onDelete: Cascade)
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignIntentId, categoryId])
  @@index([categoryId])
}

model CampaignIntentTag {
  campaignIntentId String
  tag              String
  campaignIntent   CampaignIntent @relation(fields: [campaignIntentId], references: [id], onDelete: Cascade)

  @@id([campaignIntentId, tag])
  @@index([tag])
}

model Campaign {
  id               String               @id @default(cuid())
  userId           String
  name             String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignCreators CampaignCreator[]
}

model CampaignCreator {
  campaignId String
  creatorId  String
  status     CampaignCreatorStatus @default(NOT_CONTACTED)
  addedAt    DateTime              @default(now())
  campaign   Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator    Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  notes      CampaignCreatorNote[]

  @@id([campaignId, creatorId])
  @@index([creatorId])
}

model CampaignCreatorNote {
  id         String          @id @default(cuid())
  campaignId String
  creatorId  String
  note       String
  createdAt  DateTime        @default(now())
  campaignCreator CampaignCreator @relation(fields: [campaignId, creatorId], references: [campaignId, creatorId], onDelete: Cascade)

  @@index([campaignId, creatorId])
}

model SavedCreator {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId])
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model CreatorSuggestion {
  id        String           @id @default(cuid())
  name      String
  username  String
  platform  String
  link      String?
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([username])
}


model CrawledSeed {
  id        String   @id @default(cuid())
  username  String   @unique
  platform  String   @default("INSTAGRAM")
  isSeed    Boolean  @default(true)
  crawledAt DateTime @default(now())

  @@index([username])
}
